{
  "name": "sync-ai-desktop-e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check:renderer": "node --check renderer/api.js && node --check renderer/shared.js && node --check renderer/app.js && node --check renderer/pages/chat.js && node --check renderer/pages/history.js && node --check renderer/pages/models.js && node --check renderer/pages/workspace.js && node --check renderer/pages/tasks.js && node --check renderer/pages/library.js && node --check renderer/pages/runtime.js && node --check renderer/pages/settings.js && node --check renderer/pages/preview.js",
    "build": "npm run check:renderer",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test": "node --test electron/*.test.cjs",
    "test:inference-runtime": "electron electron/inference-runtime-smoke-host.cjs",
    "test:startup": "node electron/startup-smoke.cjs"
  },
  "dependencies": {
    "node-llama-cpp": "3.22.3"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.syncnullverox.syncai",
    "productName": "Sync AI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "renderer/**/*",
      "src/*.css",
      "electron/**/*",
      "package.json",
      "!electron/*.test.cjs",
      "!electron/startup-smoke.cjs",
      "!node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/bins/win-x64*/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "node_modules/node-llama-cpp/llama/localBuilds/win-x64*/**/*",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/win-x64*/bins/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Sync-AI-Desktop-E-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins",
      "node_modules/node-llama-cpp/llama/localBuilds",
      "node_modules/@node-llama-cpp/*"
    ],
    "extraResources": [
      {
        "from": "electron/inference-memory-job.ps1",
        "to": "electron/inference-memory-job.ps1"
      }
    ]
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "node-llama-cpp": true
  }
}
