{
  "name": "sync-ai-desktop-e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test": "node --test electron/*.test.cjs",
    "test:inference-runtime": "electron electron/inference-runtime-smoke-host.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "node-llama-cpp": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.syncnullverox.syncai",
    "productName": "Sync AI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/bins/win-x64*/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "node_modules/node-llama-cpp/llama/localBuilds/win-x64*/**/*",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/win-x64*/bins/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Sync-AI-Desktop-E-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins",
      "node_modules/node-llama-cpp/llama/localBuilds",
      "node_modules/@node-llama-cpp/*"
    ],
    "extraResources": [
      {
        "from": "electron/inference-memory-job.ps1",
        "to": "electron/inference-memory-job.ps1"
      }
    ]
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "node-llama-cpp": true
  }
}
